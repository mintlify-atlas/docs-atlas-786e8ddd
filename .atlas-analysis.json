  "keyFeatures": [
    "CPU and memory hotplug with ACPI and virtio-mem support",
    "PCI device hotplug and VFIO direct device passthrough",
    "Live VM migration (local UNIX socket and remote TCP)",
    "Snapshot and restore across identical VMM versions",
    "vhost-user device offload (block, network, filesystem)",
    "virtio-fs shared filesystem via virtiofsd",
    "Windows 10/Server and Linux guest OS support",
    "REST API and D-Bus API for runtime VM management",
    "Seccomp and Landlock sandboxing for security hardening",
    "Multi-architecture support: x86-64, AArch64, riscv64 (experimental)",
    "OpenAPI 3.0 compliant REST interface",
    "KVM and Microsoft Hypervisor (MSHV) backend support"
  ],
  "publicApiSurface": [
    "POST /api/v1/vm.create",
    "PUT /api/v1/vm.boot",
    "PUT /api/v1/vm.shutdown",
